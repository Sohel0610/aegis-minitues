# ============================================================
# AEGIS Platform - Environment Variables (.env)
# ============================================================
# Copy this file to `.env` and fill in your actual values.
# Place the .env file in: Backend/aegis_backend/.env
# ============================================================

# ----------------------------------------------------------
# 1. SSO / Azure Active Directory (Authentication)
# ----------------------------------------------------------
# Set to "False" to disable SSO and run without authentication
SSO_ENABLED=False

# Azure AD credentials (required only if SSO_ENABLED=True)
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
AZURE_AD_TENANT_ID=your-azure-ad-tenant-id
AZURE_AD_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ----------------------------------------------------------
# 2. PostgreSQL Database (Optional - falls back to SQLite)
# ----------------------------------------------------------
# If these are not set, the app still runs using local SQLite DBs.
# Only needed for Directors Disclosure, Visit Tracking, etc.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DATABASE=aegis_platform
POSTGRES_DATABASE_DIRECTOR=director_disclosure_system
POSTGRES_DATABASE_BSE=aegis_bse_notification

# ----------------------------------------------------------
# 2.1 Insider Trading PostgreSQL (Specific Connection)
# ----------------------------------------------------------
# These are used specifically by the Insider Trading module (insider_trading_db.py)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aegis_insider_trading
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_CONNECT_TIMEOUT=5
# DB_SSLMODE=require 

# 3. LLM / AI Configuration (for AI Assistant & Chatbot)
# ----------------------------------------------------------
# Toggle between Groq (cloud) or Azure OpenAI
USE_GROQ=true

# --- Option A: Groq (recommended for quick setup) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Option B: Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4-o
AZURE_OPENAI_API_VERSION=2023-12-01-preview

# --- Legacy LLM keys (used by llm_utils.py) ---
LLM_ENDPOINT=https://your-resource.openai.azure.com/
LLM_DEPLOYMENT=gpt-4-o
LLM_API_KEY=your-llm-api-key

# ----------------------------------------------------------
# 4. Chatbot Minutes Module
# ----------------------------------------------------------
CHATBOT_DATABASE_URL=sqlite:///./chatbot_minutes.db
CHATBOT_UPLOAD_DIR=public/chatbot_docs
EMBEDDING_MODEL_PATH=

# ============================================================
# QUICK START (Minimal .env to just run the server):
# ============================================================
# Only these 1 variable is strictly needed to boot:
#
#   SSO_ENABLED=False
#
# Everything else has fallback defaults or is optional.
# ============================================================
