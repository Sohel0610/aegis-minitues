# --- Option A: Groq (recommended for quick setup) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Option B: Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://az10oaidmrctbtp01.openai.azure.com
